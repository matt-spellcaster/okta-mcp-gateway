# Copy to `env` (git-ignored) and fill in. None of these values are secret,
# but they identify your Okta org, so keep `env` out of version control.
# The private key is not here: scripts/new-key.py puts it in Docker's secret store.
OKTA_ORG_URL="https://your-org.okta.com"   # no "-admin" in the hostname
OKTA_CLIENT_ID="client-id-of-the-gateway-app"
OKTA_KEY_ID="printed-by-scripts/new-key.py"

# Space-separated; every scope must be granted to the gateway app in Okta.
OKTA_SCOPES="okta.users.read okta.groups.read okta.apps.read okta.logs.read okta.policies.read okta.users.manage okta.groups.manage"

# Docker MCP profile that holds the server.
PROFILE_ID="okta-gateway"
